{
  "name": "@kutana/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --build",
    "start": "node dist/main.js",
    "dev": "node --import @swc-node/register/esm-register --watch src/main.ts",
    "test": "vitest run",
    "migration:apply": "tsx src/persistence/migration-cli.ts apply",
    "migration:rollback": "tsx src/persistence/migration-cli.ts rollback"
  },
  "dependencies": {
    "@kutana/shared": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@swc-node/register": "^1.10.9",
    "@swc/core": "^1.10.1",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.8.1",
    "typescript": "^5.7.2",
    "unplugin-swc": "^1.5.1",
    "vitest": "^2.1.8"
  }
}
